# Supabase project values from `pnpm exec supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only key used exclusively to delete the signed-in user's Auth account.
# Never prefix this variable with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public application origin used to construct confirmation and password-recovery
# callbacks. Configure the same origin as Supabase Auth Site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
